APP_ENV=development
TRADING_MODE=PAPER

# Optional in Phase 1. Leave empty for local tests/scans without persistence.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Reserved for future Testnet execution. Do not add real keys in Phase 1.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# Public market source (no API key required)
BINANCE_MARKET_BASE_URL=https://api.binance.com
MARKET_QUOTE_ASSET=USDT
MARKET_MIN_QUOTE_VOLUME_24H=5000000
MARKET_MIN_TRADE_COUNT_24H=1000
MARKET_PREFILTER_LIMIT=30
MARKET_CANDIDATE_LIMIT=10
MARKET_KLINE_LIMIT=250
MARKET_MIN_CANDLES=120

# Hard risk controls; strategies/agent must never raise these automatically.
MAX_POSITION_USD=250
MAX_DAILY_BUY_USD=1000
MIN_CASH_RESERVE_PCT=25
MAX_OPEN_POSITIONS=5
DAILY_LOSS_LIMIT_USD=100
KILL_SWITCH=true
